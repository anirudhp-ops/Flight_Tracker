# Safe default: mock flight data only. Leave this false to prevent paid API calls.
ENABLE_FLIGHTAWARE_API=false

# Required only when deliberately enabling live FlightAware AeroAPI ingestion.
FLIGHTAWARE_API_KEY=

TARGET_AIRPORT=KJFK
POLL_INTERVAL_SECONDS=60

REDIS_HOST=localhost
REDIS_PORT=6379

# Comma-separated bootstrap servers the app (running on the host, not in
# Docker) connects to. Matches the native local broker (brew install kafka)
# and docker-compose.yml's kafka service, both of which publish on 9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Only relevant if the app itself is later containerized onto the same
# docker-compose network — "kafka" resolves via Docker's internal DNS there,
# "localhost" (above) does not. Unused by config.py today; documented for
# when that happens.
KAFKA_BROKER_ADDRESS=kafka:9092

DB_HOST=localhost
DB_PORT=5432
DB_NAME=flight_tracker
DB_USER=postgres
DB_PASSWORD=

# Sized for ONE shared asyncpg pool used by both server.py's startup reads
# and all WORKER_COUNT concurrent workers' writes — see
# flight_tracker/workers/CONCURRENCY.md. Keep max well under your Postgres's
# max_connections (default 100 locally).
DB_POOL_MIN_SIZE=20
DB_POOL_MAX_SIZE=50

# Concurrent worker pool (flight_tracker/workers/) — see CONCURRENCY.md.
# Note: flight-events has 3 partitions (scripts/create_kafka_topics.sh), so
# at most 3 of these workers are ever concurrently active consuming; the
# 4th (at the default) sits idle. Raise partition count to actually use more.
WORKER_COUNT=4
WORKER_RETRY_MAX_ATTEMPTS=3
WORKER_RETRY_INITIAL_DELAY_MS=100
WORKER_RETRY_MAX_DELAY_MS=30000
WORKER_BACKPRESSURE_LAG_THRESHOLD=1000
