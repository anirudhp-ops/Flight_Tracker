{
  "title": "Flight Tracker — Observability (Phase J)",
  "uid": "flight-tracker-observability",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Throughput (events/sec)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(events_received_total[1m])) by (topic)", "legendFormat": "{{topic}}", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Event processing latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(event_processing_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(event_processing_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(event_processing_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "id": 3,
      "title": "Error rate (events/sec)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(events_failed_total[1m])) by (reason)", "legendFormat": "{{reason}}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Active WebSocket connections",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 200 }, "overrides": [] },
      "targets": [
        { "expr": "active_websocket_connections", "legendFormat": "connections", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "Cache hit rate",
      "type": "gauge",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(cache_hits_total[5m])) / (sum(rate(cache_hits_total[5m])) + sum(rate(cache_misses_total[5m])))",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Kafka consumer lag",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 100 }] },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "kafka_consumer_lag", "legendFormat": "{{consumer_group}}", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "title": "Graph size (nodes/edges)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "graph_node_count", "legendFormat": "nodes", "refId": "A" },
        { "expr": "graph_edge_count", "legendFormat": "edges", "refId": "B" }
      ]
    },
    {
      "id": 8,
      "title": "Propagation latency (p95)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(propagation_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "A" }
      ]
    },
    {
      "id": 9,
      "title": "Database connection pool size",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 24, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 50 }, "overrides": [] },
      "targets": [
        { "expr": "database_connection_pool_size", "legendFormat": "pool size", "refId": "A" }
      ]
    },
    {
      "id": 10,
      "title": "Predictions/sec",
      "type": "timeseries",
      "gridPos": { "x": 18, "y": 24, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "targets": [
        { "expr": "rate(predictions_generated_total[1m])", "legendFormat": "predictions/sec", "refId": "A" }
      ]
    }
  ]
}
