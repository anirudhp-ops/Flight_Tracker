[run]
source = flight_tracker, ml
omit =
    flight_tracker/tests/*
    ml/train.py

[report]
show_missing = True
# 70%, not the 80% target: server.py (FastAPI wiring/startup/WS handler)
# and ingestion/worker.py (poll-forever loop) are 0%-covered here by
# design — see flight_tracker/TESTING.md for why — and pull the overall
# number down from the ~91% actually achieved on unit-testable code.
fail_under = 70
